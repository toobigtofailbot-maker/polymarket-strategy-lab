  "semantic_fields": {
    "applicable": true,
    "reason": "Freeze record fields, content ids, derived adaptation class, transitions, capacity, store identity, exact scope and V2.1 truth.",
    "items": [
      {
        "path": "lifecycle.content_ids",
        "source": "CONSTANT",
        "type": "content_address_rule",
        "required_rule": "Each record id = exact prefix (strategyfamily:sha256:, strategyversion:sha256:, portfolioauthoritypolicy:sha256:, portfoliopolicyreceipt:sha256:, strategyhealth:sha256:, strategyriskallocation:sha256:, strategyrestriction:sha256:) + sha256 of UTF-8 canonical JSON (sort_keys, compact separators, ensure_ascii false, allow_nan false) of the record public mapping minus its own id field; opaque refs reject path-like and secret-like text",
        "mutable": false,
        "identity_role": "NONE",
        "exclusion_reason": null,
        "validation_rule": "R001-R006 and R019",
        "failure_category": "IDENTITY_DERIVATION_INVALID",
        "safe_output": "IDENTITY_CONFLICT or FIELD_VALUE_INVALID",
        "derivation_rule_id": null
      },
      {
        "path": "lifecycle.family",
        "source": "CONSTANT",
        "type": "closed_immutable_record",
        "required_rule": "Fields schema_id,schema_version,strategy_family_id,family_key,family_label,created_time_ns,creation_provenance; family is lineage grouping only",
        "mutable": false,
        "identity_role": "NONE",
        "exclusion_reason": null,
        "validation_rule": "R001-R002",
        "failure_category": "SEMANTIC_CONTRADICTION",
        "safe_output": "FIELD_VALUE_INVALID or IDENTITY_CONFLICT",
        "derivation_rule_id": null
      },
      {
        "path": "lifecycle.version",
        "source": "CONSTANT",
        "type": "closed_immutable_record",
        "required_rule": "Fields schema_id,schema_version,strategy_version_id,strategy_family_id,parent_strategy_version_id,strategy_label,evidence_posture,strategy_code_identity,strategy_spec_json,adaptive_bounds_json,evidence_refs,created_time_ns,creation_provenance,adaptation_class; evidence posture is advisory metadata; canonical spec json bounded to 65536 bytes, depth 8, 4096 nodes, 256 parameters, 256 refs",
        "mutable": false,
        "identity_role": "NONE",
        "exclusion_reason": null,
        "validation_rule": "R003-R005, R015-R016, R044",
        "failure_category": "SEMANTIC_CONTRADICTION",
        "safe_output": "FIELD_VALUE_INVALID, LIMIT_EXCEEDED, LINEAGE_INVALID, REFERENCE_INVALID or ADAPTATION_INVALID",
        "derivation_rule_id": null
      },
      {
        "path": "lifecycle.adaptation",
        "source": "DERIVED",
        "type": "derived_closed_classification",
        "required_rule": "ROOT iff no parent; BOUNDED_ADAPTATION iff same family, posture, code identity, five rule objects, adaptive bounds and parameter key set, and at least one changed parameter with every change adaptive and inside the parent bound; otherwise MATERIAL_ADAPTATION; declared class must equal derived class; no quality judgment",
        "mutable": false,
        "identity_role": "NONE",
        "exclusion_reason": null,
        "validation_rule": "R007-R015",
        "failure_category": "SEMANTIC_CONTRADICTION",
        "safe_output": "ADAPTATION_INVALID",
        "derivation_rule_id": null
      },
      {
        "path": "lifecycle.risk_band_inheritance",
        "source": "CONSTANT",
        "type": "pure_helper",
        "required_rule": "Band order PAPER<EXPLORATORY_LIVE<VALIDATED_LIVE<MATURE_LIVE; bounded child ceiling equals parent band; material child ceiling min(parent band, EXPLORATORY_LIVE); ROOT has no inherited band; ceiling grants no authority",
        "mutable": false,
        "identity_role": "NONE",
        "exclusion_reason": null,
        "validation_rule": "R017-R018, R043",
        "failure_category": "SEMANTIC_CONTRADICTION",
        "safe_output": "ceiling band or FIELD_VALUE_INVALID",
        "derivation_rule_id": null
      },
      {
        "path": "lifecycle.policy",
        "source": "CONSTANT",
        "type": "closed_immutable_record",
        "required_rule": "Global PortfolioAuthorityPolicy outer envelope; venue scope POLYMARKET only; canonical non-negative decimal money; integer counts; pool sum <= global capital; per-strategy <= pool; per-market <= gross exposure; order notional <= per-market; created <= effective < expiry; styles non-empty unique canonical order; proposed until activated",
        "mutable": false,
        "identity_role": "NONE",
        "exclusion_reason": null,
        "validation_rule": "R019-R024",
        "failure_category": "SEMANTIC_CONTRADICTION",
        "safe_output": "POLICY_INVALID, FIELD_TYPE_INVALID or FIELD_VALUE_INVALID",
        "derivation_rule_id": null
      },
      {
        "path": "lifecycle.policy_receipt",
        "source": "CONSTANT",
        "type": "store_replay_transition",
        "required_rule": "ACTIVATE requires existing policy and previous equal current active and not already active; REVOKE requires policy and previous equal current active; non-secret human_authorization_ref required",
        "mutable": false,
        "identity_role": "NONE",
        "exclusion_reason": null,
        "validation_rule": "R034-R035",
        "failure_category": "SEMANTIC_CONTRADICTION",
        "safe_output": "POLICY_TRANSITION_INVALID",
        "derivation_rule_id": null
      },
      {
        "path": "lifecycle.health",
        "source": "CONSTANT",
        "type": "store_replay_transition",
        "required_rule": "Initial NEW; previous equals derived current; no self-transition; NEW never re-entered; RETIRED terminal; otherwise free among non-NEW states; independent of risk band",
        "mutable": false,
        "identity_role": "NONE",
        "exclusion_reason": null,
        "validation_rule": "R036-R038",
        "failure_category": "SEMANTIC_CONTRADICTION",
        "safe_output": "HEALTH_TRANSITION_INVALID",
        "derivation_rule_id": null
      },
      {
        "path": "lifecycle.allocation",
        "source": "CONSTANT",
        "type": "store_replay_transition",
        "required_rule": "Version exists; policy exists and is current active; validity inside policy window; PAPER budget exactly 0; PARENT_INHERITANCE needs parent current allocation and band <= derived ceiling; DIRECT_DECISION has no evidence gate; capacity applies; supersedes only current allocation; no per-strategy human approval field",
        "mutable": false,
        "identity_role": "NONE",
        "exclusion_reason": null,
        "validation_rule": "R041-R048",
        "failure_category": "SEMANTIC_CONTRADICTION",
        "safe_output": "ALLOCATION_INVALID or CAPACITY_INVALID",
        "derivation_rule_id": null
      },
      {
        "path": "lifecycle.restriction",
        "source": "CONSTANT",
        "type": "store_replay_transition",
        "required_rule": "APPLY needs key inactive; CLEAR needs exact active key with same kind and cap; ACTIVE_BUDGET_CAP needs canonical cap; other kinds need null cap; strategy-local only",
        "mutable": false,
        "identity_role": "NONE",
        "exclusion_reason": null,
        "validation_rule": "R039-R040",
        "failure_category": "SEMANTIC_CONTRADICTION",
        "safe_output": "RESTRICTION_TRANSITION_INVALID",
        "derivation_rule_id": null
      },
      {
        "path": "lifecycle.snapshot",
        "source": "CONSTANT",
        "type": "verified_replay_projection",
        "required_rule": "StrategyLifecycleSnapshot derived only by verified replay with fixed no credential, paper execution, order, execution and live authority flags; not independently writable",
        "mutable": false,
        "identity_role": "NONE",
        "exclusion_reason": null,
        "validation_rule": "R033-R036",
        "failure_category": "SEMANTIC_CONTRADICTION",
        "safe_output": "STORE_LOADED_VERIFIED or STORE_REJECTED",
        "derivation_rule_id": null
      },
      {
        "path": "lifecycle.capacity",
        "source": "CONSTANT",
        "type": "pure_evaluator",
        "required_rule": "Evaluate at explicit at_time_ns only active allocations: health and restriction blocks, smallest cap, per-strategy band maximum, band pools, global capital, max active strategies; reserves budget only and measures no orders, exposure, fills or PnL",
        "mutable": false,
        "identity_role": "NONE",
        "exclusion_reason": null,
        "validation_rule": "R044-R053",
        "failure_category": "SEMANTIC_CONTRADICTION",
        "safe_output": "PORTFOLIO_CAPACITY_VALID or PORTFOLIO_CAPACITY_REJECTED with closed reasons",
        "derivation_rule_id": null
      },
      {
        "path": "lifecycle.store",
        "source": "CONSTANT",
        "type": "append_only_sqlite",
        "required_rule": "format s10-strategy-lifecycle-store, schema 1, application_id 1398033457, user_version 1, journal DELETE, synchronous FULL, foreign_keys ON; exact DDL and no-update/no-delete triggers; hash chain from null genesis; single-record append; idempotent exact retry; 100000 rows, 262144 bytes per payload, 536870912 aggregate; explicit .sqlite3 path, no symlink, single hard link, no migration",
        "mutable": false,
        "identity_role": "NONE",
        "exclusion_reason": null,
        "validation_rule": "R025-R033",
        "failure_category": "SEMANTIC_CONTRADICTION",
        "safe_output": "closed store statuses and error codes",
        "derivation_rule_id": null
      },
