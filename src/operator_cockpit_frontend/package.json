{
  "name": "wp171-operator-cockpit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vite build",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --exact-port --no-open --disable-telemetry",
    "build-storybook": "storybook build --output-dir dist/storybook --disable-telemetry"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "storybook": "10.6.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
